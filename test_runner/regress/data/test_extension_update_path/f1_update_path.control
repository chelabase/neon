# A test extension whose update path 1.0 -> 1.2 runs through the untrusted 1.1
# (f1_update_path--1.1.control); 1.0 -> 1.3 is one direct, trusted step.
comment = 'fork round 4 final fix round: an update path through an untrusted version'
default_version = '1.0'
relocatable = true
superuser = true
trusted = true
